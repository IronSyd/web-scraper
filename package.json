{
  "name": "web-scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": "24.22.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "bootstrap": "5.3.8",
    "@popperjs/core": "2.11.8",
    "express": "5.3.0",
    "mongoose": "9.11.2",
    "axios": "1.20.0",
    "cheerio": "1.2.0",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "@playwright/test": "1.64.1",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.10",
    "globals": "17.13.0",
    "typescript": "7.0.2",
    "@types/node": "24.19.2",
    "@types/express": "5.0.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/bootstrap": "5.2.11"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.js",
    "api": "node --env-file-if-exists=.env apps/api/server.js",
    "build": "vite build --config apps/web/vite.config.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p tools/browser/tsconfig.json",
    "test": "node --test apps/api/test/*.test.js tools/browser/*.test.js",
    "test:e2e": "playwright test --config playwright.offline.config.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "browser:pdf": "node --env-file-if-exists=.env tools/browser/pdf.js"
  }
}
